[Unit]
Description=Client App
After=network.target

[Service]
User=root
ExecStart=

# REQUIRED. A relative DB_PATH (including the APP_NAME-derived default) resolves
# against this directory. Leave it empty and systemd starts the process in / —
# the database is then created at /<app-name>.db, not next to the binary.
WorkingDirectory=

# Runtime identity. The database is named after it (<APP_NAME>.db) whenever
# DB_PATH below is blank. Also sets the --version banner and the
# `start app=… db=… port=…` line logged at boot. Set this per app.
Environment=APP_NAME=

# Blank on purpose: derive <APP_NAME>.db inside WorkingDirectory. Set an
# absolute path here to override — an explicit value always wins.
Environment=DB_PATH=

Environment=PORT=
Environment=AUTH_URL=https://auth-center.sh-development.ru
Environment=AUTH_INTERNAL=http://localhost:8886
Environment=APP_URL=https://auth.sh-development.ru
Environment=APP_TOKEN=
Environment=SECRET_KEY=


Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
