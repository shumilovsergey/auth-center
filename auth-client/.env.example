# Auth Center integration
AUTH_URL=https://auth-center.sh-development.ru
AUTH_INTERNAL=https://auth-center.sh-development.ru
APP_URL=http://localhost:8890
APP_TOKEN=your-secret-token

# Session signing key — any random string
SECRET_KEY=change-me

# Name of this app. The database is named after it when DB_PATH is unset, so
# APP_NAME=foo gives foo.db. Defaults to the defaultAppName const in main.go.
# Also sets the --version banner and the `start app=…` log line.
APP_NAME=auth-client

# SQLite path — an explicit value always wins over the APP_NAME-derived name.
# Leave unset/blank to get <APP_NAME>.db in the working directory. In prod use
# an absolute path, or make sure the systemd unit sets WorkingDirectory=.
# DB_PATH=/data/auth-client.db

# Server port (default: 8890)
# PORT=8890
