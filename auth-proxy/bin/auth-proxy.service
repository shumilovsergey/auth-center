[Unit]
Description=Telegram Webhook Proxy
After=network.target

[Service]
User=root
ExecStart=
WorkingDirectory=

Environment=PORT=8080
Environment=AUTH_CENTER_URL=

# Grafana Telegram alerts (optional; /sh-grafana enabled only when all three are set)
Environment=GRAFANA_BOT_TOKEN=
Environment=GRAFANA_CHAT_ID=
Environment=GRAFANA_ALERT_SECRET=

# nom-nom AI proxy (optional; /nom-nom-ai enabled only when both are set)
Environment=ANTHROPIC_API_KEY=
Environment=NOM_NOM_SECRET=

# GitHub proxy (optional; /github/* enabled only when set). Comma-separated
# allowed client IPs (from X-Forwarded-For — nginx must set the real IP).
Environment=GITHUB_ALLOWED_IPS=

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
