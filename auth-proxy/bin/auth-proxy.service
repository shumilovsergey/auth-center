[Unit]
Description=Telegram Webhook Proxy
After=network.target

[Service]
User=root
ExecStart=
WorkingDirectory=

Environment=PORT=8080
Environment=AUTH_CENTER_URL=

# Grafana Telegram alerts (optional; /alert enabled only when all three are set)
Environment=GRAFANA_BOT_TOKEN=
Environment=GRAFANA_CHAT_ID=
Environment=GRAFANA_ALERT_SECRET=

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
