# Telegram bot token, from @BotFather. REQUIRED — the app refuses to start
# without it, because an unverified initData signature would let anyone assert
# any identity. Must be the token of the SAME bot auth-center uses: the two
# services derive their shared secret from it independently.
BOT_TOKEN=

# auth-center base URL for the server-to-server call to POST /miniapp/auth.
# REQUIRED. Base URL only, no path; a trailing slash is fine either way.
#   same host:      http://localhost:8886 — never leaves the machine
#   different host: https://… — must be https, the shared secret rides in the
#                   request body
AUTH_INTERNAL=https://auth-center.sh-development.ru

# Name of this app. Sets the --version banner and the `start app=…` log line.
APP_NAME=auth-miniapp

# Server port (default: 8892)
# PORT=8892

# ── this app's own public address (optional) ──────────────────────────────────
#
# Public base URL of THIS app — no path. Today one thing reads it: set it and
# the service registers a Telegram webhook on itself at startup and starts
# answering messages sent to the bot: /start gets "привет!", anything else is
# deleted. Leave it empty and none of that exists — no route, no outbound call
# to Telegram, login unchanged.
#
# The webhook path is appended for you (/webhook), so this is the app's
# address, not the endpoint's; writing the full URL works too. Must be https
# with a valid certificate — Telegram refuses anything else.
#
# There is no secret to configure: the app generates one per start and hands it
# to Telegram in the same setWebhook call, then rejects any update that comes
# back without it.
#
# Note the bot is the SAME bot as BOT_TOKEN above, and setWebhook is exclusive
# — turning this on takes the webhook away from anything else that had
# registered one for that bot.
# APP_URL=https://miniapp.example.com
