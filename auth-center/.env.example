# Сервер
PORT=8886

# Telegram-бот (@BotFather)
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=

# Секреты приложений через запятую — кто может вызывать /exchange и /delegate
APP_TOKENS=

# Куда редиректить, если auth-center открыли напрямую без ?redirect=
DIRECT_REDIRECT=

# Базовый URL Telegram API (по умолчанию https://api.telegram.org).
# Указать URL auth-proxy, если VPS не имеет доступа к Telegram:
# TELEGRAM_API_URL=https://auth-proxy.domain.com/tg-api
TELEGRAM_API_URL=

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-auth-center-domain/google/callback
